# Committed placeholder environment for the headless E2E suite (tests/e2e),
# loaded by `vite --mode test` (the `dev:test` script).
#
# SAFE TO COMMIT — these are NOT real credentials. The E2E harness intercepts
# every Supabase network call (tests/e2e/support/mockSupabase.js), so the app
# never actually reaches this host. The client in src/lib/supabase.js only needs
# the two vars present and well-formed to construct. The URL's first hostname
# label ("test") also fixes the auth storage key to `sb-test-auth-token`, which
# the seeded-session fixture (tests/e2e/support/session.js) writes to — keep them
# in agreement if this URL ever changes.
VITE_SUPABASE_URL=https://test.supabase.co
VITE_SUPABASE_ANON_KEY=e2e-placeholder-anon-key-not-a-secret
