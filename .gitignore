node_modules
dist
# Broad on purpose: every .env variant holds live credentials, and a new one
# must never depend on someone remembering to add a line here.
.env
.env.*
# Exception: the E2E placeholder env is committed on purpose. It holds no real
# credentials — the suite mocks every network call (see the file's own header).
!.env.test

# Lighthouse CI run output (lighthouserc.json writes reports here)
.lighthouseci

# Playwright MCP session artifacts — screenshots and accessibility snapshots
# written while reviewing screens against the mockups. Working notes, not
# deliverables, and they run to tens of megabytes within a single session.
.playwright-mcp/

# Netlify CLI local link state (written by `netlify deploy`). Machine-local —
# CI passes the site through NETLIFY_SITE_ID instead.
.netlify

# Personal Claude Code overrides — contains machine-local absolute paths
.claude/settings.local.json

# Agent worktrees — full checkouts of this repo. Untracked but not ignored,
# `git add .` stages them as an embedded-repo gitlink, not as files.
.claude/worktrees/

# Design mockups. Untracked deliberately — this repo is public, and the bundle is
# ~600 KB of prototype HTML plus an unused second design system. Everything
# load-bearing from it now lives in the repo as docs/REDESIGN.md amendments,
# CONTEXT.md terms, and (later) src/styles/tokens.css.
# See docs/REDESIGN.md — Amendment 16.
UI mockups for form/
UI mockups for form.zip

/src/generated/prisma

# Was `.xlsx`, which matches only a file literally named ".xlsx" — it protected
# nothing. Spreadsheets reaching this repo are member exports, i.e. PII.
*.xlsx

# One-off member import from the Contact Information Google Form. Holds the
# source spreadsheet, the reviewed name/group CSV, and its own node_modules —
# real member PII and a script that writes to production. Never deployed, never
# committed; deleted once the import is done.
/upload-member-script/

# Local Netlify folder
.netlify

# Playwright E2E run output (reports, traces, screenshots) — regenerated per run.
/test-results/
/playwright-report/
/playwright/.cache/
